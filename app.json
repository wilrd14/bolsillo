{
  "expo": {
    "name": "Bolsillo",
    "slug": "bolsillo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bolsillo",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
