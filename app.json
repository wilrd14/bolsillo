{
  "expo": {
    "name": "Bolsillo",
    "slug": "bolsillo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bolsillo",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bolsillo usa la cámara para fotografiar tus facturas y extraer sus datos.",
          "photosPermission": "Bolsillo accede a tus fotos solo para que elijas la factura que quieres escanear.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
